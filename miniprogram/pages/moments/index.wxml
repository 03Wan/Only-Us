<!-- live-data-only-v3 -->
<!-- qa-audited: keep behavior in scripts/qa-views.cjs -->
<!-- Native reconstruction of stitch_only_us/_1; no Web HTML runtime. -->
<app-header title="此间有你" back="{{false}}"/>
<view class="native-screen native-page-moments native-tab-page"><view wx:if="{{cloudMode && syncIssue && !(syncIssue === 'binding' && key === 'bind')}}" class="qa-status" aria-live="polite"><text>{{syncIssue === 'binding' ? '连接另一半，共享你们的记录' : '暂时无法同步，请重试'}}</text><button wx:if="{{syncIssue === 'error'}}" bindtap="onAction" data-action="refresh" disabled="{{loading || busy}}" aria-label="重试同步">重试</button><button wx:else="" bindtap="onAction" data-action="route" data-value="bind" disabled="{{busy}}" aria-label="连接另一半">去连接</button></view>    <view class="u60 u61 u63 native-flexible native-content">  <view class="u64"> <view class="u5 u18 u19 native-between"> <view class="u65 u66 u1 u43 u59">平行时刻</view> <text class="u46 u67 u31 u68 u69 u56 u57">{{cloudMode ? "共同空间" : "本机记录"}}</text> </view> <view class="u70 u71 u51">不同的生活，同一份分享欲。</view> <button bindtap="onAction" data-action="route" data-value="waiting" class="native-state-link" hover-class="native-pressed" aria-label="route">查看等待状态</button></view>     <view class="qa-toolbar"><view class="qa-section-title">日常记录</view><button class="qa-link" bindtap="onAction" data-action="month" data-value="" aria-label="month">{{monthFilter}}</button></view><view wx:if="{{!visibleMoments.length}}" class="qa-card qa-empty">还没有记录，拍下今天想分享的一刻吧。</view><view wx:for="{{visibleMoments}}" wx:key="id" class="qa-card"><view class="qa-toolbar"><text>{{item.mine ? (mine || '我') : (partner || 'TA')}} · {{item.dayKey}}</text><button bindtap="onAction" data-action="favoriteMoment" data-value="{{item.id}}" disabled="{{busy}}" class="qa-link" aria-label="favoriteMoment">{{item.favorite ? '已珍藏 · 取消' : '珍藏'}}</button></view><view class="qa-photo-grid"><image wx:for="{{item.photos}}" wx:for-item="photoUrl" wx:key="*this" src="{{photoUrl}}" mode="aspectFill" binderror="onImageError" bindtap="onAction" data-action="previewMoment" data-value="{{item.id}}"/></view><view class="qa-body">{{item.content}}</view><view class="qa-toolbar"><button class="qa-link" bindtap="onAction" data-action="previewMoment" data-value="{{item.id}}" aria-label="previewMoment">查看详情</button><button wx:if="{{item.mine}}" class="qa-link" bindtap="onAction" data-action="deleteRecord" data-value="moments:{{item.id}}" aria-label="deleteRecord">删除</button></view></view><view wx:if="{{historyCount > 3}}" class="qa-history-controls"><button class="qa-link" bindtap="onAction" data-action="moreHistory">{{moreHistory ? "收起历史记录" : "展开历史记录"}}</button><view wx:if="{{moreHistory && historyPages > 1}}" class="qa-history-pages"><button class="qa-link" bindtap="onAction" data-action="historyPrev" disabled="{{historyPage <= 1}}">上一页</button><text>第 {{historyPage}} / {{historyPages}} 页</text><button class="qa-link" bindtap="onAction" data-action="historyNext" disabled="{{historyPage >= historyPages}}">下一页</button></view></view><button wx:if="{{cloudMode && hasMore}}" class="qa-link" bindtap="onAction" data-action="loadMore" disabled="{{busy}}">加载更早记录</button></view>  <view class="u13 u150 u15 u7 u8 u16 u61 u151 u152 u5 u6 native-fixed-action"> <button bindtap="onAction" data-action="route" data-value="editor" class="u153 u5 u18 u135 u154 u155 u31 u74 u156 u157 u158 u159 u36 u37 u38" hover-class="native-pressed" aria-label="route"> <image src="/assets/icons/photo_camera-0b4bca83.png" class="native-icon u39" style="width:calc(38.462 * var(--layout-unit));height:calc(38.462 * var(--layout-unit));" mode="aspectFit"/> <text class="u160 u161 u44">记录今天 / 拍下此刻</text> <image src="/assets/icons/flare-75b90c0d.png" class="native-icon u39" style="width:calc(34.615 * var(--layout-unit));height:calc(34.615 * var(--layout-unit));" mode="aspectFit"/> </button> </view>    </view>
<state-panel token="{{feedbackToken}}" visible="{{!!feedback && !editorKind}}" message="{{feedback}}" kind="{{feedbackKind}}" binddismiss="dismissFeedback" bindretry="retryAction" retryable="{{!!retry}}"/>
