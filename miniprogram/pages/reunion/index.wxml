<!-- feature-editors-v3 -->
<!-- qa-audited: keep behavior in scripts/qa-views.cjs -->
<!-- Native reconstruction of stitch_only_us/_4; no Web HTML runtime. -->
<app-header title="此间有你" back="{{false}}"/>
<view class="native-screen native-page-reunion native-tab-page"><view wx:if="{{cloudMode && syncIssue && !(syncIssue === 'binding' && key === 'bind')}}" class="qa-status" aria-live="polite"><text>{{syncIssue === 'binding' ? '连接另一半，共享你们的记录' : '暂时无法同步，请重试'}}</text><button wx:if="{{syncIssue === 'error'}}" bindtap="onAction" data-action="refresh" disabled="{{loading || busy}}" aria-label="重试同步">重试</button><button wx:else="" bindtap="onAction" data-action="route" data-value="bind" disabled="{{busy}}" aria-label="连接另一半">去连接</button></view>    <view class="u60 u61 u5 u10 u437 native-flexible native-content">  <view class="u5 u10 u95"> <view class="u5 u18 u28"> <text class="u52 u53 u31 u354 u438"/> <view class="u439 u440 u32 u59">下一站，见你。</view> </view> <view class="u111 u112 u51 u441">穿过山海与人海，奔赴属于我们的拥抱。</view> </view>  <view class="reunion-hero"><image class="reunion-hero-art" src="/assets/backgrounds/reunion-twilight.jpg" mode="aspectFill"/><view class="reunion-hero-shade"/><view class="reunion-hero-content"><view class="reunion-hero-top"><text class="reunion-hero-chip">下一站 · 见你</text><text class="reunion-hero-people">{{mine || '我'}} ♡ {{partner || 'TA'}}</text></view><view class="reunion-countdown"><view class="reunion-countdown-label">{{meetingLabel}}</view><view><text class="reunion-countdown-number">{{meetingDate ? meetingDays : '—'}}</text><text class="reunion-countdown-unit">天</text></view><view class="reunion-countdown-date">{{meetingDate || '约一个日子，把想念变成相见'}}</view></view><view class="reunion-hero-quote">穿过山海，下一站就是你的身边。</view><picker mode="date" value="{{meetingDate || today}}" start="{{today}}" bindchange="onDate" data-field="meetingDate"><view class="qa-date-action">{{meetingDate ? '修改见面日期' : '约定见面日期'}} ›</view></picker></view></view>  <view class="feature-ticket"><view class="qa-toolbar"><view class="feature-ticket-heading"><text class="feature-ticket-train">{{ticket ? ticket.train + ' 次' : '下一张相见车票'}}</text><text>恋爱专属旅程</text></view><text class="feature-ticket-status">{{ticket ? ticket.status : '待设置'}}</text></view><view wx:if="{{ticket}}"><view class="feature-ticket-route"><view><view class="feature-station">{{ticket.from}}</view><text>{{ticket.departure}} 出发</text></view><view class="feature-ticket-duration"><text>{{ticketDuration}}</text><view class="feature-route-line"/><text>直达你的身边</text></view><view class="feature-ticket-destination"><view class="feature-station">{{ticket.to}}</view><text>{{ticket.arrival}} 到达</text></view></view><view class="feature-ticket-footer"><image src="/assets/icons/confirmation_number-279f6947.png" mode="aspectFit"/><view><view>{{ticket.date}} → {{ticket.arrivalDate}}</view><text>{{ticket.seat || '座位待补充'}}</text></view><text class="feature-ticket-heart">见你</text></view></view><view wx:else="" class="feature-ticket-empty">填下车次、车站和时间，把下一次见面认真收藏。</view><button class="qa-link" bindtap="onAction" data-action="ticket" data-value="" disabled="{{busy}}">{{ticket ? "修改车票" : "设置相见车票"}}</button><button wx:if="{{ticket}}" class="qa-link" bindtap="onAction" data-action="deleteTicket" disabled="{{busy}}">删除车票</button><view class="feature-ticket-hint">相见行程记录</view></view>  <view class="u85 u227 u201 u49 u50 u88 u5 u10 u389"> <view class="u5 u18 u19 u386 native-between"> <view class="u5 u18 u28"> <image src="/assets/icons/format_list_bulleted-919f539b.png" class="native-icon u39" style="width:calc(34.615 * var(--layout-unit));height:calc(34.615 * var(--layout-unit));" mode="aspectFit"/> <view class="u41 u42 u1">下次见面想做的事</view> </view> <text class="u56 u57 u119 u58 u502 u107 u67 u31">{{wishCount}}/{{wishTotal}} 已兑现</text> </view>  <view class="feature-wishes" id="wishlist-container"><view wx:if="{{!wishRows.length}}" class="data-wish-empty qa-empty">还没有心愿，添加一件想一起做的事吧。</view><view wx:for="{{wishRows}}" wx:key="id" class="feature-wish {{item.done ? 'feature-wish-done' : ''}}"><view class="feature-wish-main"><button class="feature-check {{item.done ? 'feature-check-on' : ''}}" bindtap="onAction" data-action="toggleWish" data-value="{{item.id}}" aria-label="{{item.done ? '标记未完成' : '完成心愿'}}" disabled="{{busy}}"><image wx:if="{{item.done}}" src="/assets/icons/check-d216fb8a.png" mode="aspectFit"/></button><view class="feature-wish-copy"><view class="feature-wish-title">{{item.text}}</view><view class="feature-wish-note">{{item.done ? '已完成 ✨' : (item.note || '期待一起完成')}}</view></view></view><view class="feature-wish-actions"><button class="qa-link" bindtap="onAction" data-action="editWish" data-value="{{item.id}}" disabled="{{busy}}">编辑</button><button wx:if="{{item.id.length > 1}}" class="qa-link" bindtap="onAction" data-action="deleteWish" data-value="{{item.id}}" disabled="{{busy}}">删除</button></view></view></view>  <button bindtap="onAction" data-action="addWish" class="u116 u7 u125 u266 u49 u267 u513 u514 u515 u32 u160 u161 u5 u18 u6 u45 u249 u516" hover-class="native-pressed" aria-label="addWish"> <image src="/assets/icons/add_circle-a5dbcc25.png" class="native-icon u39" style="width:calc(30.769 * var(--layout-unit));height:calc(30.769 * var(--layout-unit));" mode="aspectFit"/> 添加心愿 </button> </view>   </view>   <include src="/shared/feature-editor.wxml"/></view>
<state-panel token="{{feedbackToken}}" visible="{{!!feedback && !editorKind}}" message="{{feedback}}" kind="{{feedbackKind}}" binddismiss="dismissFeedback" bindretry="retryAction" retryable="{{!!retry}}"/>
