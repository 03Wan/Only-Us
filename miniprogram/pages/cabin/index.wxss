/* Page 3: shared native design tokens and utilities are in app.wxss. */

.note-filters{display:flex;flex-wrap:wrap}.note-row{margin-top:14rpx}.note-row-top{display:flex;align-items:center;justify-content:space-between}.note-category{font-size:23rpx;color:#775c99}.note-action{display:inline-block;margin-left:14rpx}.note-content{white-space:pre-wrap;word-break:break-all}

.cabin-received{display:flex;align-items:center;gap:18rpx;margin:18rpx 8rpx;padding:20rpx 24rpx;border-radius:24rpx;background:#fff4f7;color:#74516a;font-size:27rpx;font-weight:600}.cabin-received-heart{color:#d67e9e;font-size:38rpx}.cabin-received-date{margin-top:4rpx;color:#a5899a;font-size:21rpx;font-weight:400}.cabin-affection-animation{position:fixed;z-index:100;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none}.cabin-affection-animation-center{padding:28rpx 44rpx;border-radius:36rpx;background:rgba(104,76,129,.92);color:#fff;text-align:center;box-shadow:0 12rpx 40rpx #5a3e6b40;animation:affection-pop 1.4s ease both}.cabin-affection-animation-center text{font-size:72rpx;color:#ffdae7}.cabin-affection-animation-center view{font-size:25rpx}.cabin-affection-float{position:absolute;color:#e98aaa;font-size:42rpx;animation:affection-float 1.4s ease-out both}.cabin-affection-float-one{margin-left:-160rpx}.cabin-affection-float-two{margin-left:160rpx;animation-delay:.1s}.cabin-affection-float-three{margin-left:90rpx;animation-delay:.2s}@keyframes affection-pop{0%{opacity:0;transform:scale(.65)}20%{opacity:1;transform:scale(1.08)}75%{opacity:1;transform:scale(1)}100%{opacity:0;transform:scale(.92)}}@keyframes affection-float{0%{opacity:0;transform:translateY(45rpx) scale(.6)}25%{opacity:1}100%{opacity:0;transform:translateY(-140rpx) scale(1.2)}}

/* Lightweight filters share the paper card palette. */
.native-screen .note-filters { gap:8px;margin:12px 0 8px; }
.native-screen .note-chip { display:inline-flex;align-items:center;justify-content:center;min-height:32px;margin:0;padding:4px 12px;border:1px solid transparent;border-radius:16px;background:transparent;color:#9b8caa;font-size:13px;line-height:1.6;font-weight:400; }
.native-screen .note-chip::after { border:0; }
.native-screen .note-chip-active { background:#f0e9f5;border-color:#e7dcef;color:#79618e;font-weight:500; }
