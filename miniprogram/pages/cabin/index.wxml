<app-header title="此间有你" back="{{false}}" id="page-header" settings="{{true}}" bindsettings="onSettings"/>
<view class="native-screen native-page-cabin native-tab-page"><view wx:if="{{cloudMode && syncIssue && !(syncIssue === 'binding' && key === 'bind')}}" class="qa-status" aria-live="polite"><text>{{syncIssue === 'binding' ? '连接另一半，共享你们的记录' : '暂时无法同步，请重试'}}</text><button wx:if="{{syncIssue === 'error'}}" bindtap="onAction" data-action="refresh" disabled="{{loading || busy}}" aria-label="重试同步">重试</button><button wx:else="" bindtap="onAction" data-action="route" data-value="bind" disabled="{{busy}}" aria-label="连接另一半">去连接</button></view>      <view class="u61 u5 u10 u325 native-content">  <view class="cabin-summary"><view class="cabin-summary-top"><view class="cabin-summary-home"><image class="" src="/assets/icons/cottage-5955f0b4.png" mode="aspectFit"/></view><view class="cabin-summary-name"><view class="cabin-summary-kicker">OUR LITTLE HOME</view><view class="cabin-summary-title">{{cabinName || '我们的小屋'}}</view></view><button id="dayNightToggle" class="cabin-mode-toggle {{daytime ? 'cabin-mode-day' : ''}}" bindtap="onAction" data-action="dayNight" hover-class="native-pressed" aria-label="{{daytime ? '当前白天，切换到夜晚' : '当前夜晚，切换到白天'}}"><image src="{{daytime ? '/assets/icons/wb_sunny-d6cc1085.png' : '/assets/icons/dark_mode-12b14477.png'}}" mode="aspectFit"/><text id="toggleLabel">{{daytime ? '日间暖阳' : '晚间月光'}}</text></button></view><view class="cabin-summary-bottom"><view class="cabin-summary-people"><view class="cabin-summary-identity"><view class="cabin-summary-avatars"><view class="cabin-summary-avatar"><image wx:if="{{avatar0}}" src="{{avatar0}}" mode="aspectFill"/><text wx:else="">{{roleMine || '我'}}</text></view><view class="cabin-summary-avatar cabin-summary-avatar-partner"><image wx:if="{{avatar1}}" src="{{avatar1}}" mode="aspectFill"/><text wx:else="">{{rolePartner || 'TA'}}</text></view></view><view class="cabin-summary-names">{{(mine || '我') + ' 与 ' + (partner || 'TA')}}</view></view><button wx:if="{{!bound}}" class="cabin-pair-link" bindtap="onAction" data-action="