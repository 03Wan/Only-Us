      28% { transform: scale(1); }
      42% { transform: scale(1.04); }
      70% { transform: scale(1); }
    }
@keyframes starlight {
      0%, 100% { opacity: 0.3; transform: scale(0.85); }
      50% { opacity: 1; transform: scale(1.15); }
