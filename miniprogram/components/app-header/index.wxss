.header { position:fixed;top:0;left:0;right:0;z-index:90;background:rgba(253,248,255,.96);backdrop-filter:blur(18px);box-sizing:border-box; }
.bar { display:flex;align-items:center;padding-left:calc(30.769 * var(--layout-unit));box-sizing:border-box; }
.brand { display:flex;align-items:center;gap:calc(12 * var(--layout-unit));background:transparent;color:#605487;line-height:1.3;margin:0;padding:0;min-height:40px;text-align:left;overflow:hidden;border:0; }
.brand::after { border:0; }
.title { font-size:calc(30 * var(--layout-unit));font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
.lead { font-size:calc(38 * var(--layout-unit));line-height:1; }
.pressed { opacity:.75; }
.brand { min-width:0;min-height:44px; }
.title { font-size:16px; }
.lead { font-size:24px; }
@media (min-width:600px) { .bar { padding-left:max(28px,calc((100vw - 704px) / 2)); } }

.bar { gap:12px; }
.brand { flex:1; }
.settings { display:flex;align-items:center;justify-content:center;width:44px;min-width:44px;height:44px;margin:0;border:0;background:transparent;padding:10px; }
.settings::after { border:0; }
.settings image { width:22px;height:22px;opacity:.8; }
