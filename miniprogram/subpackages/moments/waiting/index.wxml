<!-- live-data-only-v3 -->
<!-- qa-audited: keep behavior in scripts/qa-views.cjs -->
<!-- Native reconstruction of stitch_only_us/_11; no Web HTML runtime. -->
<app-header title="平行时刻 · 等待" back="{{true}}"/>
<view class="native-screen native-page-waiting native-secondary"><view wx:if="{{cloudMode && syncIssue && !(syncIssue === 'binding' && key === 'bind')}}" class="qa-status" aria-live="polite"><text>{{syncIssue === 'binding' ? '连接另一半，共享你们的记录' : '暂时无法同步，请重试'}}</text><button wx:if="{{syncIssue === 'error'}}" bindtap="onAction" data-action="refresh" disabled="{{loading || busy}}" aria-label="重试同步">重试</button><button wx:else="" bindtap="onAction" data-action="route" data-value="bind" disabled="{{busy}}" aria-label="连接另一半">去连接</button></view>    <view class="u60 u61 u198 native-flexible native-content"><view class="qa-card"><view class="qa-section-title">今天的记录</view><text class="qa-caption">{{cloudMode ? '以共同空间的记录为准' : '记录保存在当前设备'}} </text></view><view wx:if="{{!moments.length}}" class="qa-card qa-empty">还没有发布记录，先留下今天的一刻吧。</view><view wx:for="{{moments}}" wx:key="id" class="qa-card"><view class="qa-caption">{{item.dayKey}}</view><view class="qa-photo-grid"><image wx:for="{{item.photos}}" wx:for-item="url" wx:key="*this" src="{{url}}" mode="aspectFill"/></view><view class="qa-body">{{item.content}}</view></view><button class="qa-link" bindtap="onAction" data-action="route" data-value="editor">继续记录</button><button class="qa-link" bindtap="onAction" data-action="route" data-value="moments">返回日常</button></view>   </view>
<state-panel token="{{feedbackToken}}" visible="{{!!feedback && !editorKind}}" message="{{feedback}}" kind="{{feedbackKind}}" binddismiss="dismissFeedback" bindretry="retryAction" retryable="{{!!retry}}"/>

