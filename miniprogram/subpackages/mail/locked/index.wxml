<!-- live-data-only-v3 -->
<!-- qa-audited: keep behavior in scripts/qa-views.cjs -->
<!-- Native reconstruction of stitch_only_us/_12; no Web HTML runtime. -->
<app-header title="未解锁信件" back="{{true}}"/>
<view class="native-screen native-page-locked native-secondary"><view wx:if="{{cloudMode && syncIssue && !(syncIssue === 'binding' && key === 'bind')}}" class="qa-status" aria-live="polite"><text>{{syncIssue === 'binding' ? '连接另一半，共享你们的记录' : '暂时无法同步，请重试'}}</text><button wx:if="{{syncIssue === 'error'}}" bindtap="onAction" data-action="refresh" disabled="{{loading || busy}}" aria-label="重试同步">重试</button><button wx:else="" bindtap="onAction" data-action="route" data-value="bind" disabled="{{busy}}" aria-label="连接另一半">去连接</button></view><view class="qa-reader" wx:if="{{recordId}}"><view class="qa-card"><view class="qa-section-title">{{letterTitle || '月亮邮局'}}</view><view wx:if="{{!recordLoaded}}" class="qa-empty">正在加载信件…</view><view wx:elif="{{letterLocked}}" class="qa-empty">尚未到服务器设定的启封时间。下拉刷新再次检查。</view><view wx:else="" class="qa-letter-body">{{letterBody}}</view><text wx:if="{{openAt}}" class="qa-caption">启封日期：{{openAt}}</text></view><button class="qa-primary" bindtap="onAction" data-action="refresh" aria-label="refresh">重新检查启封状态</button><button wx:if="{{!letterLocked}}" class="qa-link" bindtap="onAction" data-action="favoriteLetter" aria-label="favoriteLetter">珍藏 / 取消珍藏</button><button class="qa-link" bindtap="onAction" data-action="back" aria-label="back">返回月亮邮局</button></view>          <view wx:if="{{!recordId}}" class="qa-card qa-empty">请从月亮邮局选择一封信件。<button class="qa-link" bindtap="onAction" data-action="route" data-value="mailbox">返回月亮邮局</button></view></view>
<state-panel token="{{feedbackToken}}" visible="{{!!feedback && !editorKind}}" message="{{feedback}}" kind="{{feedbackKind}}" binddismiss="dismissFeedback" bindretry="retryAction" retryable="{{!!retry}}"/>

