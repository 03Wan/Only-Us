<!-- qa-audited: keep behavior in scripts/qa-views.cjs -->
<!-- live-data-only-v3 -->
<app-header title="我们的回忆馆" back="{{true}}"/><state-panel message="{{feedback}}" kind="{{feedbackKind}}" token="{{feedbackToken}}" visible="{{!!feedback && !editorKind}}" binddismiss="dismissFeedback" bindretry="retryAction" retryable="{{!!retry}}"/>
<view class="native-screen native-page-memories native-secondary"><view wx:if="{{cloudMode && syncIssue && !(syncIssue === 'binding' && key === 'bind')}}" class="qa-status" aria-live="polite"><text>{{syncIssue === 'binding' ? '连接另一半，共享你们的记录' : '暂时无法同步，请重试'}}</text><button wx:if="{{syncIssue === 'error'}}" bindtap="onAction" data-action="refresh" disabled="{{loading || busy}}" aria-label="重试同步">重试</button><button wx:else="" bindtap="onAction" data-action="route" data-value="bind" disabled="{{busy}}" aria-label="连接另一半">去连接</button></view><view class="memory-page"><view class="memory-page-intro"><view class="memory-page-kicker">PAGES OF US</view><view class="memory-page-title">把日子，写成我们的故事</view><view class="memory-page-description">一场散步、一段旅程，还有那些想一起记住的小事。</view><button class="memory-create" bindtap="onAction" data-action="story" disabled="{{busy}}" aria-label="story"><text>＋</text><text>留下一页故事</text></button></view><view class="memory-page-toolbar"><text>故事手账</text><text>{{stories.length}} 篇{{cloudMode && hasMore ? ' · 已加载' : ''}}</text></view><view wx:if="{{!visibleStories.length}}" class="qa-card qa-empty">还没有自己的篇章，记住今天的一件小事吧。</view><view wx:for="{{visibleStories}}" wx:key="id" class="feature-story"><view class="qa-toolbar"><text class="feature-story-date">{{item.mine ? (mine || '我') : (partner || 'TA')}} · {{item.dayKey || '时光里的一页'}}</text><text class="feature-story-place">{{item.weather}}{{item.weather && item.location ? ' · ' : ''}}{{item.location}}</text></view><view class="feature-story-title">{{item.title || '我们的故事'}}</view><view class="feature-story-body memory-story-excerpt">{{item.content}}</view><button class="qa-link memory-read" bindtap="onAction" data-action="storyDetail" data-value="{{item.id}}">阅读全文 ›</button><view wx:if="{{item.photos.length}}" class="feature-polaroid"><view class="feature-story-image"><image src="{{item.photos[0]}}" mode="aspectFill" bindtap="onAction" data-action="previewStory" data-value="{{item.id}}" binderror="onImageError"/><text class="feature-photo-date">{{item.dayKey}}</text></view><view class="feature-caption">{{item.caption || '把这一刻，留在此间有你。'}}<image src="/assets/icons/favorite-876e38f1.png" mode="aspectFit"/></view></view><view wx:if="{{item.mine}}" class="feature-record-actions"><button class="qa-link" bindtap="onAction" data-action="editStory" data-value="{{item.id}}" disabled="{{busy}}" aria-label="editStory">编辑故事</button><button class="qa-link" bindtap="onAction" data-action="deleteRecord" data-value="stories:{{item.id}}" disabled="{{busy}}" aria-label="deleteRecord">删除</button></view></view><view wx:if="{{historyPages > 1}}" class="qa-history-pages"><button class="qa-link" bindtap="onAction" data-action="historyPrev" disabled="{{historyPage <= 1}}" aria-label="historyPrev">上一页</button><text>第 {{historyPage}} / {{historyPages}} 页</text><button class="qa-link" bindtap="onAction" data-action="historyNext" disabled="{{historyPage >= historyPages}}" aria-label="historyNext">下一页</button></view><button wx:if="{{cloudMode && hasMore}}" class="qa-link" bindtap="onAction" data-action="loadMore" disabled="{{busy}}" aria-label="loadMore">加载更早故事</button></view><include src="/shared/feature-editor.wxml"/></view>
