<!-- Shared page-scoped editor: include preserves Page data and event handlers. -->
<view wx:if="{{editorKind}}" class="feature-overlay {{editorKind === 'note' || editorKind === 'tag' ? 'feature-overlay-compact' : ''}}"><view class="feature-backdrop" bindtap="onAction" data-action="closeEditor" catchtouchmove="stopFeatureTouch"/><view class="feature-sheet {{editorKind === 'note' || editorKind === 'tag' ? 'feature-sheet-compact' : (editorKind === 'story' ? 'feature-sheet-story' : '')}} {{editorKind === 'settings' ? 'feature-sheet-settings' : ''}}"><view class="feature-sheet-header"><view>{{editorKind === 'story' ? (editId ? '编辑这一页故事' : '留下一页故事') : editorKind === 'wish' ? (editId ? '编辑心愿' : '添加心愿') : editorKind === 'ticket' ? '设置相见车票' : editorKind === 'note' ? '一张小屋便签' : editorKind === 'tag' ? '这一刻的标签' : (settingsSection === 'privacy' ? '隐私与数据' : settingsSection === 'about' ? '关于小屋' : '小屋设置')}}</view><button class="qa-link" bindtap="onAction" data-action="closeEditor" data-value="" disabled="{{busy}}">关闭</button></view><scroll-view class="feature-sheet-scroll" scroll-y="{{true}}" enhanced="{{true}}" scroll-top="{{settingsScrollTop}}"><view class="feature-form"><block wx:if="{{editorKind === 'story'}}"><view class="feature-story-form"><view class="feature-label">故事标题 *</view><input class="feature-input" value="{{storyTitle}}" data-field="storyTitle" bindinput="featureField" maxlength="80" placeholder="填写故事标题"/><view class="feature-story-meta"><view><view class="feature-label">故事日期 *</view><picker mode="date" value="{{storyDate}}" bindchange="featureDate" data-field="storyDate"><view class="feature-input feature-picker">{{storyDate}} ›</view></picker></view><view><view class="feature-label">天气</view><picker mode="selector" range="{{weatherOptions}}" bindchange="weatherChange"><view class="feature-input feature-picker">{{storyWeather || '选择天气'}} ⌄</view></picker></view></view><view class="feature-label">故事地点</view><input class="feature-input" value="{{storyLocation}}" data-field="storyLocation" bindinput="featureField" maxlength="60" placeholder="记录发生的地点"/><view class="feature-label">故事正文 *</view><textarea class="feature-textarea feature-story-textarea" value="{{storyContent}}" data-field="storyContent" bindinput="featureField" maxlength="2000" placeholder="那天发生了什么，你还记得哪些细节？" cursor-spacing="24"/><view class="feature-story-photo-heading"><text class="feature-label">照片</text><text>选填 · 留住当时的画面</text></view><view wx:if="{{storyPhoto}}" class="feature-editor-photo"><image src="{{storyPhoto}}" mode="aspectFill" binderror="onImageError"/><view class="qa-toolbar"><button class="qa-link" bindtap="onAction" data-action="storyPhoto" data-value="" disabled="{{busy}}">更换照片</button><button class="qa-link" bindtap="onAction" data-action="removeStoryPhoto" data-value="" disabled="{{busy}}">移除照片</button></view></view><view wx:else=""><button class="feature-photo-add feature-story-photo-add" bindtap="onAction" data-action="storyPhoto"><image src="/assets/icons/photo_camera-45c744cf.png" mode="aspectFit"/><text>从相册 / 拍照添加</text></button></view><view class="feature-label">照片下的一句话</view><input class="feature-input" value="{{storyCaption}}" data-field="storyCaption" bindinput="featureField" maxlength="120" placeholder="写一句想一起记住的话"/><view class="qa-caption">暂时关闭会保留新故事草稿。</view></view></block><block wx:elif="{{editorKind === 'wish'}}"><view class="feature-label">想一起做的事 *</view><input class="feature-input" value="{{wishText}}" data-field="wishText" bindinput="featureField" maxlength="200" placeholder="写下你们的下一个小心愿"/><view class="feature-label">备注 / 小约定</view><input class="feature-input" value="{{wishNote}}" data-field="wishNote" bindinput="featureField" maxlength="120" placeholder="时间、地点，或需要提前准备的事"/></block><block wx:elif="{{editorKind === 'ticket'}}"><view class="feature-form-grid"><view><view class="feature-label">车次 *</view><input class="feature-input" value="{{ticketForm.train}}" data-field="train" bindinput="featureField" maxlength="20" placeholder=""/></view><view><view class="feature-label">座位 / 车厢</view><input class="feature-input" value="{{ticketForm.seat}}" data-field="seat" bindinput="featureField" maxlength="60" placeholder=""/></view><view><view class="feature-label">出发站 *</view><input class="feature-input" value="{{ticketForm.from}}" data-field="from" bindinput="featureField" maxlength="30" placeholder=""/></view><view><view class="feature-label">到达站 *</view><input class="feature-input" value="{{ticketForm.to}}" data-field="to" bindinput="featureField" maxlength="30" placeholder=""/></view><view><view class="feature-label">出发日期 *</view><picker mode="date" value="{{ticketForm.date}}" bindchange="featureDate" data-field="date"><view class="feature-input feature-picker">{{ticketForm.date}} ›</view></picker></view><view><view class="feature-label">到达日期 *</view><picker mode="date" value="{{ticketForm.arrivalDate}}" bindchange="featureDate" data-field="arrivalDate"><view class="feature-input feature-picker">{{ticketForm.arrivalDate}} ›</view></picker></view><view><view class="feature-label">出发时间 *</view><picker mode="time" value="{{ticketForm.departure}}" bindchange="featureDate" data-field="departure"><view class="feature-input feature-picker">{{ticketForm.departure || '选择时间'}} ›</view></picker></view><view><view class="feature-label">到达时间 *</view><picker mode="time" value="{{ticketForm.arrival}}" bindchange="featureDate" data-field="arrival"><view class="feature-input feature-picker">{{ticketForm.arrival || '选择时间'}} ›</view></picker></view></view><view class="feature-label">行程状态</view><view class="feature-status-options"><button class="feature-chip {{ticketForm.status === '待购票' ? 'feature-chip-active' : ''}}" bindtap="onAction" data-action="ticketStatus" data-value="待购票" disabled="{{busy}}">待购票</button><button class="feature-chip {{ticketForm.status === '已出票' ? 'feature-chip-active' : ''}}" bindtap="onAction" data-action="ticketStatus" data-value="已出票" disabled="{{busy}}">已出票</button><button class="feature-chip {{ticketForm.status === '已相聚' ? 'feature-chip-active' : ''}}" bindtap="onAction" data-action="ticketStatus" data-value="已相聚" disabled="{{busy}}">已相聚</button></view><view class="qa-caption">保存后，见面倒计时会跟随到达日期更新；跨天行程请选择到达日期。</view></block><block wx:elif="{{editorKind === 'note'}}"><view class="feature-note-intro">把想说的话，轻轻留在这里。</view><view class="feature-label">分类</view><picker mode="selector" range="{{noteCategoryOptions}}" value="{{noteCategoryIndex}}" bindchange="noteCategoryChange" disabled="{{busy}}"><view class="feature-input feature-note-category-picker"><text>{{noteCategoryCustom ? '自定义分类' : noteCategory}}</text><text class="feature-note-category-arrow">⌄</text></view></picker><input wx:if="{{noteCategoryCustom}}" class="feature-input feature-note-category-custom" value="{{noteCategory}}" data-field="noteCategory" bindinput="featureField" maxlength="20" placeholder="输入新分类，如约定、日常"/><view class="feature-note-paper"><textarea class="feature-note-textarea" value="{{noteDraft}}" data-field="noteDraft" bindinput="featureField" maxlength="1000" placeholder="今晚的约定、日常的小提醒，或者一句想你了……" placeholder-class="feature-note-placeholder" cursor-spacing="28" adjust-position="{{true}}"/><view class="feature-note-count">{{noteDraft.length}} / 1000</view></view></block><block wx:elif="{{editorKind === 'tag'}}"><view class="feature-note-intro">给今天的这一刻，起个小小的名字。</view><view class="feature-tag-input-row"><text>#</text><input class="feature-tag-input" value="{{tagDraft}}" data-field="tagDraft" bindinput="featureField" maxlength="21" placeholder="写一个标签" cursor-spacing="28"/></view><view class="feature-tag-label">也可以选一个</view><view class="feature-tag-options"><button wx:for="{{tagOptions}}" wx:key="*this" class="feature-tag-option {{'#' + tagDraft === item ? 'feature-tag-option-active' : ''}}" bindtap="onAction" data-action="pickTag" data-value="{{item}}">{{item}}</button></view><button class="feature-tag-clear" bindtap="onAction" data-action="clearTag" data-value="" disabled="{{busy}}">不添加标签</button></block><block wx:else=""><view class="settings-menu" wx:if="{{settingsSection === 'menu'}}"><view class="settings-home"><view class="settings-home-top"><view class="settings-home-symbol"><image class="" src="/assets/icons/cottage-5955f0b4.png" mode="aspectFit"/></view><text class="settings-home-label">只属于我们的空间</text><view class="settings-connection"><view class="settings-status-dot {{bound ? 'settings-status-connected' : ''}}"/><text>{{bound ? '已连接' : '待连接'}}</text></view></view><view class="settings-home-name">{{cabinName || '我们的小屋'}}</view><view class="settings-home-people"><view class="settings-avatar"><image wx:if="{{avatar0}}" src="{{avatar0}}" mode="aspectFill"/><text wx:else="">我</text></view><view class="settings-avatar settings-avatar-partner"><image wx:if="{{avatar1}}" src="{{avatar1}}" mode="aspectFill"/><text wx:else="">TA</text></view><text>{{(mine || '我') + ' · ' + (partner || 'TA')}}</text></view></view><view class="settings-group-label">个人与小屋</view><view class="settings-group"><button class="settings-item" bindtap="onAction" data-action="settingsRoute" data-value="profile"><view class="settings-item-icon"><image src="/assets/icons/photo_camera-45c744cf.png" mode="aspectFit"/></view><view class="settings-item-copy"><view class="settings-item-title">个人资料</view><view class="settings-item-description">昵称、头像</view></view><text class="settings-item-arrow">›</text></button><button class="settings-item" bindtap="onAction" data-action="chooseRole" disabled="{{busy}}"><view class="settings-item-icon"><image src="/assets/icons/mood-283714b7.png" mode="aspectFit"/></view><view class="settings-item-copy"><view class="settings-item-title">角色形象</view><view class="settings-item-description">{{roleMine || '选择一个小动物'}}</view></view><text class="settings-item-arrow">›</text></button><button class="settings-item" bindtap="onAction" data-action="settingsInfo" data-value="home"><view class="settings-item-icon"><image src="/assets/icons/cottage-5955f0b4.png" mode="aspectFit"/></view><view class="settings-item-copy"><view class="settings-item-title">小屋设置</view><view class="settings-item-description">名称、日夜与动画</view></view><text class="settings-item-arrow">›</text></button><button class="settings-item" bindtap="onAction" data-action="settingsInfo" data-value="reminders"><view class="settings-item-icon"><image src="/assets/icons/schedule-bde44a5e.png" mode="aspectFit"/></view><view class="settings-item-copy"><view class="settings-item-title">提醒设置</view><view class="settings-item-description">心意、信件与纪念日</view></view><text class="settings-item-arrow">›</text></button></view><view class="settings-group-label">连接与数据</view><view class="settings-group"><button class="settings-item " bindtap="onAction" data-action="settingsInfo" data-value="account" disabled="{{busy}}" hover-class="settings-item-pressed"><view class="settings-item-icon"><image class="" src="/assets/icons/diversity_1-5264f20e.png" mode="aspectFit"/></view><view class="settings-item-copy"><view class="settings-item-title">账号与连接</view><view class="settings-item-description">微信身份及双人连接状态</view></view><text class="settings-item-arrow">›</text></button><button class="settings-item " bindtap="onAction" data-action="settingsInfo" data-value="privacy" disabled="{{busy}}" hover-class="settings-item-pressed"><view class="settings-item-icon"><image class="" src="/assets/icons/lock-bd0eb68c.png" mode="aspectFit"/></view><view class="settings-item-copy"><view class="settings-item-title">隐私与数据</view><view class="settings-item-description">了解保存、共享与删除方式</view></view><text class="settings-item-arrow">›</text></button><button class="settings-item " bindtap="onAction" data-action="settingsInfo" data-value="about" disabled="{{busy}}" hover-class="settings-item-pressed"><view class="settings-item-icon"><image class="" src="/assets/icons/cottage-5955f0b4.png" mode="aspectFit"/></view><view class="settings-item-copy"><view class="settings-item-title">关于小屋</view><view class="settings-item-description">版本、功能与项目主页</view></view><text class="settings-item-arrow">›</text></button></view><view class="settings-footnote">把平凡的日子，慢慢过成我们的故事。</view></view><view wx:elif="{{settingsSection === 'home'}}" class="settings-info-page"><button class="settings-info-back" bindtap="onAction" data-action="settingsInfo" data-value="menu">‹ 返回设置</button><view class="settings-info-card"><view class="settings-info-heading">小屋名称</view><view>{{cabinName || '尚未设置'}}</view><button class="settings-info-back" bindtap="onAction" data-action="settingsRoute" data-value="profile">修改小屋名称 ›</button></view><view class="settings-info-card"><view class="settings-info-heading">日间模式 <switch checked="{{daytime}}" data-field="daytime" bindchange="settingsToggle" color="#775c99"/></view><view>关闭后显示夜间小屋，保存在本设备。</view></view><view class="settings-info-card"><view class="settings-info-heading">动作动画 <switch checked="{{animationEnabled}}" data-field="animationEnabled" bindchange="settingsToggle" color="#775c99"/></view><view>控制抱抱等动作的动画，保存在本设备。</view></view><view class="settings-info-card"><view class="settings-info-heading">动作音效 <switch checked="{{soundEnabled}}" data-field="soundEnabled" bindchange="settingsToggle" color="#775c99"/></view><view>控制抱抱等动作的提示音，保存在本设备。</view></view></view><view wx:elif="{{settingsSection === 'reminders'}}" class="settings-info-page"><button class="settings-info-back" bindtap="onAction" data-action="settingsInfo" data-value="menu">‹ 返回设置</button><view class="settings-info-card"><view class="settings-info-heading">心意提醒</view><view>进入小屋后可查看对方最近送来的心意。</view></view><view class="settings-info-card"><view class="settings-info-heading">信件提醒</view><view>请在信箱查看收到的信件。</view></view><view class="settings-info-card"><view class="settings-info-heading">纪念日提醒</view><view>请在纪念日页面查看日期。</view></view><view class="settings-info-card">微信消息提醒尚未配置，当前不会发送站外通知。</view></view><view wx:elif="{{settingsSection === 'privacy'}}" class="settings-info-page" id="settings-privacy"><button class="settings-info-back" bindtap="onAction" data-action="settingsInfo" data-value="menu">‹ 返回小屋设置</button><view class="settings-info-intro"><view class="settings-info-symbol">🔒</view><view class="settings-info-title">让记录安心留在小屋</view><view class="settings-info-subtitle">你的记录，由你管理</view></view><view class="settings-info-card"><view class="settings-info-heading">记录保存在哪里</view><view>{{cloudMode ? "连接后，双方可以查看保存在共同小屋中的记录。" : "记录目前保存在这台设备上，对方暂时无法查看。清理小程序缓存可能导致记录丢失。"}}</view></view><view class="settings-info-card"><view class="settings-info-heading">由你决定分享什么</view><view>关闭“同步给TA看”后，对方看不到你的心情及碎碎念。未来信件按约定日期启封，双方私语按相应规则显示。</view><view>照片仅在你主动更换头像或添加图片时选择；不会主动读取相册、通讯录或位置，目前也不采集电量。</view></view><view class="settings-info-card"><view class="settings-info-heading">配对关系</view><view>{{bound ? ((mine || "我") + " 与 " + (partner || "TA") + " 已连接") : "尚未连接"}}</view><button class="settings-info-back" bindtap="onAction" data-action="settingsInfo" data-value="account">查看连接与解除 ›</button></view><view class="settings-info-card"><view class="settings-info-heading">数据导出</view><view>导出当前可查看的文字数据为 JSON；照片文件不包含在内，未启封信件的正文不会导出。</view><button class="settings-info-back" bindtap="onAction" data-action="exportData" disabled="{{busy}}">导出文字记录 ›</button></view><view class="settings-info-card"><view class="settings-info-heading">管理与删除</view><view>删除我的个人内容：删除自己的资料、心情、收藏及发布的日常、故事和信件；云端共同列表中的这些记录也会删除。共同便签、心愿和已上传照片文件保留。</view><button class="settings-info-back" bindtap="onAction" data-action="deletePersonal" disabled="{{busy}}">删除我的个人内容 ›</button><view>清除本机数据：删除这台设备上的记录、草稿和可识别的关联照片；不会删除云端共同小屋的数据。本机模式下清除后无法恢复，请先导出。</view><button class="settings-info-back" bindtap="onAction" data-action="clearLocalData" disabled="{{busy}}">清除本机数据 ›</button></view></view><view wx:elif="{{settingsSection === 'account'}}" class="settings-info-page" id="settings-account"><button class="settings-info-back" bindtap="onAction" data-action="settingsInfo" data-value="menu">‹ 返回小屋设置</button><view class="settings-info-intro"><view class="settings-info-symbol">♡</view><view class="settings-info-title">账号与连接</view><view class="settings-info-subtitle">{{bound ? '已连接' : '尚未连接'}}</view></view><view class="settings-info-card"><view class="settings-info-heading">微信身份</view><view>{{cloudMode ? '使用当前微信身份，无需单独输入账号密码。' : '当前记录保存在这台设备上。'}}</view></view><view class="settings-info-card"><view class="settings-info-heading">双人连接</view><view>{{bound ? '你们已连接。' : '你们还没有连接。'}}</view><view wx:if="{{bound}}">解除连接后，双方将无法访问原来的共同空间。</view><button wx:if="{{cloudMode && bound}}" class="settings-info-back" bindtap="onAction" data-action="unlink" disabled="{{busy}}">解除双人连接 ›</button></view><button wx:if="{{!bound}}" class="settings-info-back" bindtap="onAction" data-action="settingsRoute" data-value="bind">前往双人连接 ›</button></view><view wx:else="" class="settings-info-page" id="settings-about"><button class="settings-info-back" bindtap="onAction" data-action="settingsInfo" data-value="menu">‹ 返回小屋设置</button><view class="settings-info-intro"><view class="settings-about-logo"><image class="" src="/assets/icons/cottage-5955f0b4.png" mode="aspectFit"/></view><view class="settings-info-title">此间有你 · Only Us</view><view class="settings-info-subtitle">把平凡的日子，慢慢过成我们的故事。</view><text class="settings-version">版本 0.1.0</text></view><view class="settings-info-card"><view class="settings-info-heading">只属于两个人的日常</view><view>一间可以切换日夜的小屋，一份可以分享的心情，一封写给未来的信，还有每次相见前的小小期待。</view><view>抱抱、摸头、捶背，或者记下一页故事，把想念变成看得见的陪伴。</view></view><button class="settings-project-button" bindtap="onAction" data-action="copyProjectUrl"><view><view class="settings-info-heading">项目主页</view><view>github.com/03Wan/Only-Us</view></view><text>复制 ›</text></button><button class="settings-info-back" bindtap="onAction" data-action="settingsInfo" data-value="privacy">查看隐私与数据说明 ›</button></view></block><view wx:if="{{feedback && feedbackKind === 'error'}}" class="feature-form-error">{{feedback}}</view></view></scroll-view><view class="feature-sheet-footer" wx:if="{{editorKind !== 'settings'}}"><button class="qa-link" bindtap="onAction" data-action="closeEditor" data-value="" disabled="{{busy}}">取消</button><button class="feature-save" bindtap="onAction" data-action="saveFeature" data-value="" disabled="{{busy}}">{{busy ? "保存中…" : "保存"}}</button></view></view></view>
